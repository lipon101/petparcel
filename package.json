{
  "name": "webapp-fullstack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/_core/index.ts",
    "dev:web": "vite",
    "build": "pnpm migrate:deploy && pnpm sync:catalog && pnpm sitemap && pnpm merchant:feed && pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-server.mjs",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "sync:catalog": "tsx scripts/sync-catalog.ts",
    "options:rebuild": "node scripts/build-option-schema-module.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx scripts/reset-db.ts",
    "seed": "tsx scripts/seed.ts",
    "prune:catalog": "tsx scripts/prune-catalog.ts",
    "admin:create": "tsx scripts/make-admin.ts",
    "set-password": "tsx scripts/set-password.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "merchant:feed": "tsx scripts/generate-merchant-feed.ts",
    "verify:merchant-landing": "node scripts/verify-merchant-landing-pages.mjs",
    "verify:images": "tsx scripts/verify-product-images.ts",
    "check:feed-images": "node scripts/check-feed-images.mjs --module",
    "images:enlarge": "node scripts/enlarge-small-images.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:live-api": "tsx scripts/check-live-api.ts",
    "verify:ui-fixes": "node scripts/verify-ui-fixes.mjs",
    "verify:variants": "node scripts/verify-variant-swatches.mjs",
    "verify:real-options": "node scripts/verify-real-options.mjs",
    "verify:auth-cart": "node scripts/verify-auth-cart.mjs",
    "check:vercel-config": "node scripts/check-vercel-config.mjs",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify:bachs": "tsx scripts/verify-bachs-config.ts",
    "check:unpaid-orders": "tsx scripts/check-unpaid-orders.ts",
    "verify:search-security": "node scripts/verify-search-security.mjs",
    "verify:search-edge-cases": "node scripts/verify-search-edge-cases.mjs",
    "telegram:test": "tsx scripts/send-telegram-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@hono/trpc-server": "0.3.4",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-label": "2.1.12",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.7",
    "jose": "6.2.3",
    "lucide-react": "1.25.0",
    "nodemailer": "^10.1.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "wouter": "3.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@bachs/sdk": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "playwright": "^1.55.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
