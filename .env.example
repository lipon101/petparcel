# ── PetParcel environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/petparcel

# DB driver (optional). "tcp" (default) = node-postgres pool — Node runtime only.
# "http" = @neondatabase/serverless over HTTPS — REQUIRED for the Vercel Edge
# runtime, which has no TCP socket API (node-postgres cannot run there).
# DB_DRIVER=http

# Session signing secret (required) — a long random string
JWT_SECRET=change-me-to-a-long-random-string

# ── Payments (optional) ──────────────────────────────────────────────────────
# 2Checkout is the ONLY payment method. Leave both keys blank and the store
# still runs end-to-end: orders are recorded as unpaid for offline settlement
# until your merchant account is connected. Keys are read from the environment
# only — never the DB.

# 2Checkout / Verifone — accepts Bangladesh merchants + US cards
TWOCHECKOUT_SELLER_ID=
TWOCHECKOUT_SECRET_KEY=
TWOCHECKOUT_MODE=test

# ── Admin bootstrap (only used by `pnpm admin:create`) ───────────────────────
# ADMIN_EMAIL=you@yourstore.com
# ADMIN_PASSWORD=a-strong-password
