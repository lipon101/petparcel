# ── PetParcel environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/petparcel

# Session signing secret (required) — a long random string
JWT_SECRET=change-me-to-a-long-random-string

# ── Payments (optional) ──────────────────────────────────────────────────────
# Leave everything blank to run in `manual` mode: orders are recorded as unpaid
# and settled offline. Keys are read from the environment only — never the DB.

# 2Checkout / Verifone — recommended for a Bangladesh-based merchant
TWOCHECKOUT_SELLER_ID=
TWOCHECKOUT_SECRET_KEY=
TWOCHECKOUT_MODE=test

# ── Admin bootstrap (only used by `pnpm admin:create`) ───────────────────────
# ADMIN_EMAIL=you@yourstore.com
# ADMIN_PASSWORD=a-strong-password
