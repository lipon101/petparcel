# ── PetParcel environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/petparcel

# Session signing secret (required) - a long random string
JWT_SECRET=change-me-to-a-long-random-string

# ── Auth provider ─────────────────────────────────────────────────────────────
# "local" (default) = the app's own bcrypt + JWT login.
# "neon"            = Neon Auth (Better Auth); the credential lives in Neon's
#                     `neon_auth` schema and the app verifies its JWT via JWKS.
# Set AUTH_PROVIDER=neon AND the two NEON_AUTH_* vars below to switch. With
# AUTH_PROVIDER unset the app keeps using the local path, so this is opt-in.
AUTH_PROVIDER=local

# Neon Auth base URL, from the Neon console -> your project -> Auth.
# Shape: https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# NAMES ONLY here - never commit the real value.
NEON_AUTH_URL=

# Optional. Defaults to <NEON_AUTH_URL>/.well-known/jwks.json when unset.
NEON_AUTH_JWKS_URL=

# ── Sign-in ───────────────────────────────────────────────────────────────
# Sign-in is email + password, plus "Continue with Google". Google is handled
# entirely by Neon Auth (the OAuth exchange happens on its origin), so there is
# NO client secret or client id in this app and nothing to configure here - the
# provider's own console holds the Google credentials. The only value that must
# agree is the provider's trusted-origin list, which has to include this site's
# origin so the browser is allowed back to /auth/callback. That is a console
# setting, so it has no environment variable.

# ── Product media storage (Cloudflare R2) ───────────────────────────────────
# Product images and videos (uploads, "add by URL", and supplier-link imports)
# are stored in a Cloudflare R2 bucket: 10 GB free, $0 egress, S3-compatible.
# All FIVE must be set for the R2 driver to activate; with any missing, the app
# falls back to the platform object store, and with neither the admin form says
# exactly which variables to add. NAMES ONLY here - never commit the values.
#
# WHERE THE VALUES COME FROM (Cloudflare dashboard):
#   R2_ACCOUNT_ID        R2 -> Overview (the account id, also in the endpoint).
#   R2_ACCESS_KEY_ID     R2 -> Manage API Tokens -> Create -> S3 API token.
#   R2_SECRET_ACCESS_KEY  shown ONCE when that token is created.
#   R2_BUCKET            the bucket name you created.
#   R2_PUBLIC_BASE_URL   bucket -> Settings -> Public access (the r2.dev URL or
#                        your custom domain), WITHOUT a trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Payments: crypto via NOWPayments ─────────────────────────────────────────
# NOWPayments is the ONLY payment method. Leave the keys blank and the store
# still runs end-to-end: orders are recorded as unpaid for offline settlement
# until your NOWPayments account is connected. Keys are read from the
# environment only - never the DB, never committed.
#
# WHERE THE VALUES COME FROM (NOWPayments dashboard):
#   NOWPAYMENTS_API_KEY       Account -> API keys -> generate. Sent as the
#                             `x-api-key` header on OUR outbound calls. It can
#                             move money, so it stays server-side ONLY.
#   NOWPAYMENTS_IPN_SECRET    Store settings -> Payments -> IPN -> generate the
#                             IPN secret key. Used to verify THEIR inbound
#                             callbacks (HMAC-SHA512). Without it the webhook
#                             route refuses every request.
#   NOWPAYMENTS_PAY_CURRENCY  OPTIONAL. Pin one coin (e.g. usdttrc20, btc, eth).
#                             Blank = the shopper chooses on the hosted invoice.
#   NOWPAYMENTS_API_BASE      OPTIONAL. Leave blank for production
#                             (https://api.nowpayments.io/v1).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=
NOWPAYMENTS_API_BASE=

# ── Telegram order notifications (owner's private channel) ──────────────────
# A private, real-time ping the moment a payment SETTLES: order id, amount +
# currency, the product(s) ordered and the customer's country. Sent from the
# SAME verified payment paths as the paid receipt (the HMAC-checked NOWPayments
# IPN, the live status reconciliation, the post-return confirmation), so a
# forged return URL can never trigger one.
#
# WHERE THE VALUES COME FROM:
#   TELEGRAM_BOT_TOKEN  the bot's API token from @BotFather. Message @BotFather
#                       -> /newbot (or /mybots -> your bot -> API Token). Shape
#                       `123456789:AAH...`. It can post as the bot, so it is
#                       SERVER-SIDE ONLY - never sent to a browser, never
#                       logged, never returned in an API response or an error.
#                       Vercel -> Project -> Settings -> Environment Variables.
#   TELEGRAM_CHAT_ID    the destination. HOW TO GET IT:
#                         1. Add the bot to the private channel/group as an
#                            admin (a channel bot cannot read or post otherwise),
#                            or open a DM with the bot and press Start.
#                         2. Send any message in it (or to it).
#                         3. Open
#                            https://api.telegram.org/bot<TOKEN>/getUpdates
#                            and read `result[].message.chat.id` (a DM/personal
#                            id is positive, e.g. 123456789; a channel or
#                            supergroup id is negative, e.g. -1001234567890).
#                        A public @channelusername works too and can be pasted
#                        verbatim, but a NUMERIC id is preferred: a rename would
#                        silently break a handle, and never would break an id.
#   TELEGRAM_MESSAGE_THREAD_ID  OPTIONAL. Only for a forum/topics-enabled
#                       supergroup, to pin notifications to one topic.
#
# LEAVING EITHER BLANK IS A NORMAL STATE, NOT AN ERROR. Notifications are then
# skipped and the store runs exactly as before - checkout is never blocked, and
# the admin order view says plainly that Telegram is not configured.
# NAMES ONLY here - never a value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=
# Optional, for a test stub only. Leave blank for production.
# TELEGRAM_API_BASE=

# ── Admin bootstrap + SINGLE-ADMIN designation ───────────────────────────────
# ADMIN_EMAIL is used in TWO places:
#   * at runtime, to PIN the admin panel to exactly ONE account. `adminAuth.login`
#     only mints a session for this address, and every `admin.*` procedure
#     refuses any other account (even one that somehow carries the admin role).
#   * by `pnpm admin:create` / `pnpm seed`, to bootstrap that owner account.
# Set it to the store owner's address. Read from the environment ONLY - never
# committed. When unset, the coarse `users.role='admin'` check applies on its own.
ADMIN_EMAIL=
# Only used by `pnpm admin:create` (bootstrap) - never read by the server.
# ADMIN_PASSWORD=a-strong-password

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Resend API key (Sending access). Absent ⇒ the store still runs and records
# each attempt in `email_log` as `skipped`. NAMES ONLY here - never a value.
RESEND_API_KEY=

# Optional default From address, e.g. `PetParcel <orders@petparcel.store>`.
# The store's Settings → Email value wins when set; this is the env fallback.
EMAIL_FROM=

# Resend webhook signing secret (Svix), shown when you add the webhook in the
# Resend dashboard. Used to verify `POST /api/webhooks/resend`. Absent ⇒ the
# receiver refuses every request (it cannot verify a signature without a key).
RESEND_WEBHOOK_SECRET=

# ── Auth email (Neon Auth → Resend) ──────────────────────────────────────────
# Neon Auth (Managed Better Auth) sends the auth emails: signup email
# verification, password reset and magic-link sign-in. By default it delivers
# them through its SHARED sender `auth@mail.myneon.app`. Point it at Resend so
# they go out from the owner's own verified `petparcel.store` domain.
#
# WHERE THESE ARE SET: the SMTP values below are entered in the **Neon console**
# (Auth → Configuration → Email provider → Custom SMTP), NOT in Vercel - Neon
# Auth sends the mail itself, so Vercel never sees them. They are listed here as
# NAMES ONLY so the settings are documented in one place. Never commit values.
#
#   Host      smtp.resend.com
#   Port      465 (SSL; 587 = STARTTLS)
#   Username  resend
#   Password  <the RESEND_API_KEY value>       ← RESEND_SMTP_PASS (name only)
#   Sender    auth@petparcel.store             ← must be on the verified domain
#   Sender name   PetParcel
#
# RESEND_SMTP_HOST=smtp.resend.com
# RESEND_SMTP_PORT=465
# RESEND_SMTP_USER=resend
# RESEND_SMTP_PASS=
#
# Optional. The From header the app uses IF you deliver auth emails yourself
# (the webhook path). App env, name only. The auth
# sender on the owner's own domain; the store's Settings → Email value does NOT
# override it, so auth mail is never mixed with the orders inbox.
AUTH_EMAIL_FROM=

# ── Secondary SMTP provider (Brevo) ────────────────────────────────────────
# The SECOND provider, used for every NON-critical email - signup verification,
# password reset, magic-link sign-in, contact-form replies, welcome mail and any
# other notification (see server/_core/email-routing.ts). Critical mail (order
# confirmation, payment/shipping confirmation, the admin's new-order alert) keeps
# going through Resend above.
#
# WHY A SECOND PROVIDER: Resend's free tier has a hard DAILY cap. When it is
# reached every send fails, including a customer's receipt. The two providers
# have SEPARATE allowances, so a burst of signups can never exhaust the quota the
# receipt depends on.
#
# WHY BREVO: a real SMTP relay with our own custom domain and DKIM/SPF that does
# NOT stamp its own branding on transactional mail sent through the relay, so the
# customer sees only PetParcel. ~9,000 emails/month free (300/day), well above
# this store's non-critical volume.
#
# The bare SMTP_HOST/PORT/USER/PASS names are still accepted as a FALLBACK alias
# (a BREVO_* value wins), so a deployment that already set them keeps working.
# NAMES ONLY here - never a value.
#   Host      smtp-relay.brevo.com
#   Port      587 (STARTTLS) or 465 (implicit TLS)
#   Username  your Brevo SMTP login
#   Password  the Brevo SMTP key (NOT the API key)
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# "true" for implicit TLS (port 465); leave unset/false for STARTTLS (587/2525).
BREVO_SMTP_SECURE=
# The From header for secondary mail, e.g. `PetParcel <support@petparcel.store>`.
# Falls back to EMAIL_FROM when unset.
BREVO_FROM_EMAIL=
# The `X-Mailer` identity secondary mail advertises. Optional; defaults to
# "PetParcel". Not a secret - set it only to change the visible display value.
SMTP_X_MAILER=

# ── CJdropshipping integration ────────────────────────────────────────────────
# The store fulfils through CJdropshipping via CJ's REST API (api2.0/v1) - the
# "API / Others" route, because this is a custom React + Node storefront and
# none of CJ's platform plugins (Shopify, WooCommerce, Wix, …) apply.
#
# WHERE THE KEY COMES FROM: cjdropshipping.com → My CJ → Authorization → API →
# API Key. Its shape is `CJUserNum@api@xxxxxxxx…`. NAMES ONLY here - never a
# value. Absent is a NORMAL state: the integration fails safe (logs clearly,
# does nothing) so checkout keeps working and no order is silently dropped.
CJ_API_KEY=

# The CJ account email, recorded on each forwarded order's remark so a human can
# reconcile the store order against the CJ order.
CJ_EMAIL=

# Default CJ logistics route name used when creating an order. CJ requires a
# `logisticName`; "CJPacket Ordinary" is CJ's own standard line. Change it to
# whichever route the account is set up to use.
CJ_LOGISTIC_NAME=CJPacket Ordinary

# Origin country the parcel ships from (two-letter code).
CJ_FROM_COUNTRY_CODE=CN

# ── SANDBOX / LIVE SWITCH ─────────────────────────────────────────────────────
# FALSE (or unset) = SANDBOX. Orders are created with CJ's `isSandbox: 1` flag:
# simulated payment, no real charge, no real logistics, no fulfilment. This is
# the default so a misconfiguration can never place a real supplier order.
# Set to `true` ONLY when you are ready to place REAL, PAID CJ orders.
CJ_LIVE_MODE=false

# ── VERCEL CRON SECRET ─────────────────────────────────────────────────────────
# The stock and tracking sync jobs are registered in the app but nothing CALLS
# them on a schedule by itself. Vercel Cron does: it hits
#   GET /api/cron/cj-stock-sync     (daily, 03:00 UTC)
#   GET /api/cron/cj-tracking-sync  (daily, 03:30 UTC)
#   GET /api/cron/live-api-health-check (daily, 08:00 UTC)
# with `Authorization: Bearer $CRON_SECRET`. Set CRON_SECRET to any long random
# string here (and in the Vercel project env) — the route refuses every caller
# while it is unset, so it can never be triggered anonymously. The schedules live
# in vercel.json (crons).
#
# HOBBY PLAN: a Vercel Hobby account only allows crons that run at most ONCE PER
# DAY. Any more frequent expression FAILS THE DEPLOYMENT with "Hobby accounts are
# limited to daily cron jobs. This cron expression would run more than once per
# day." The schedules above are therefore daily. The tradeoff versus the previous
# every-6-hours cadence is that CJ stock and tracking refresh once a day instead
# of four times; that is acceptable because a real purchase is never blocked on
# it - stock is validated from CJ at the moment of checkout, and a paid order's
# tracking is pulled on demand. To get a sub-daily cadence back you would need a
# paid Vercel plan; do NOT reintroduce it here.
CRON_SECRET=

# ── LIVE API HEALTH CHECK (optional) ─────────────────────────────────────────
# The daily job and `pnpm check:live-api` probe the LIVE origin's
# /trpc/settings.public and assert it answers 2xx JSON with a real settings
# payload - the exact thing that was broken when sign-in showed
# `Unexpected token 'T', "The page c"...`, while every local check stayed green.
#
# Leave this UNSET in normal operation: it defaults to the production storefront
# (STORE_URL). Set it only to point the probe elsewhere - at a Vercel PREVIEW
# deployment, to check it before it takes production traffic, or at a
# deliberately broken host, which is how the failure path is exercised. A NAMES
# ONLY file, so never commit a real value that carries credentials.
LIVE_API_URL=

# ── CLOUDFLARE TURNSTILE (optional) ──────────────────────────────────────────
# Bot protection for the two public forms that make the server do work: signup
# and the contact form. Cloudflare's Security Center flags an account with no
# Turnstile widget; this is the control it asks for.
#
# FAIL-OPEN WHEN UNSET. With no TURNSTILE_SECRET_KEY the server check is a no-op
# and the forms behave exactly as before, so this is safe to leave blank until
# the widget exists. The moment the secret is set, a missing or invalid token is
# refused - turning the feature on is a single env change, no code deploy.
#
# WHERE TO GET THEM: Cloudflare dashboard → Turnstile → Add widget → the site
# (petparcel.store). The widget gives you a SITE key (public) and a SECRET key.
#   TURNSTILE_SECRET_KEY   the SECRET key - server-side only, never shipped to
#                          the browser, never committed. Set it in Vercel.
#   VITE_TURNSTILE_SITE_KEY the SITE key - PUBLIC by design (it is meant to be
#                          in the page). Set it in Vercel too; Vite inlines it
#                          into the client bundle at build time.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
